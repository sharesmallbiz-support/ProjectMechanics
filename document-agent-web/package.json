{
  "name": "project-mechanics",
  "version": "3.0.0",
  "description": "Unified Project Mechanics site: Methodology + Document Agent Tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run test:run && npm run build && node scripts/validate-build.js",
    "generate-sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/node": "^24.10.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.553.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "happy-dom": "^12.10.3",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.18",
    "vite": "^5.4.20",
    "vitest": "^1.6.1"
  }
}
