# Document Agent API Configuration

# Application
APP_NAME="Document Agent API"
APP_VERSION="1.0.0"
BUILD_DATE="2025-11-18"
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# Security - CHANGE THIS IN PRODUCTION!
JWT_SECRET_KEY="change-me-in-production-use-a-secure-random-key-at-least-32-characters-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Services - Add your API keys here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
DEFAULT_AI_MODEL=gpt-4

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (requests per minute)
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=60
RATE_LIMIT_ENTERPRISE=300

# Prompts Directory (optional, defaults to ./data/prompts)
# PROMPTS_DIR=/path/to/prompts
